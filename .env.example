NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://localhost:27017/cyber_ai
OPENAI_API_KEY=replace_me
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
JWT_SECRET=replace_with_at_least_32_random_characters
JWT_ISSUER=cyber-api
CORS_ORIGIN=http://localhost:5173
VECTOR_INDEX_NAME=security_chunks_vector
RAG_TOP_K=8
MAX_UPLOAD_CHARS=200000
MCP_PORT=4100

# Tenant-bound MCP worker used by the LLM orchestrator
MCP_TENANT_ID=tenant-acme
MCP_COMMAND=node
MCP_ARGS=["dist/mcp/server.js"]
